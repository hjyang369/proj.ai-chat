                "schema": {
                  "type": "string"
                },
                "example": "data: {\"type\":\"job\",\"uid\":\"…\"}\n\ndata: {\"type\":\"content\",\"content\":\"…\"}\n\ndata: {\"type\":\"done\",\"ms_no\":1,\"status\":\"completed\"}\n\n"
